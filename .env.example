# Gatherly AI Environment Configuration
# Default AI mode: 'local' (Ollama), 'demo' (deterministic offline sample mode), or 'remote' (FastAPI proxy)
VITE_AI_PROVIDER=demo

# Local Ollama URL (when VITE_AI_PROVIDER=local)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:3b

# Remote API URL (when VITE_AI_PROVIDER=remote)
VITE_REMOTE_API_BASE_URL=http://localhost:8000
